{
  "name": "zotero-paper2speech",
  "version": "0.2.1",
  "type": "module",
  "description": "Read selected Zotero papers aloud with built-in macOS speech",
  "author": "wei",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeiCheng14159/zotero_paper2speech.git"
  },
  "config": {
    "addonName": "Paper2Speech",
    "addonID": "zotero-paper2speech@zotero.local",
    "addonRef": "zotero-paper2speech",
    "addonInstance": "Paper2Speech",
    "prefsPrefix": "extensions.zotero.zotero-paper2speech"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "engines": {
    "node": ">=22.8"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}
